{
  "name": "dsfr-editor",
  "version": "0.1.0",
  "description": "Éditeur de contenu type Notion (BlockNote) avec des blocs du Système de Design de l'État (DSFR)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./src/styles/index.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "workspaces": [
    "demo"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace demo",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "demo:dev": "npm run dev --workspace demo",
    "demo:build": "npm run build --workspace demo",
    "demo:preview": "npm run preview --workspace demo"
  },
  "keywords": [
    "dsfr",
    "react-dsfr",
    "blocknote",
    "editor",
    "wysiwyg",
    "notion",
    "systeme-de-design",
    "codegouvfr"
  ],
  "peerDependencies": {
    "@blocknote/ariakit": "0.54.0",
    "@blocknote/core": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@codegouvfr/react-dsfr": "^1.34.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@blocknote/ariakit": "0.54.0",
    "@blocknote/core": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@codegouvfr/react-dsfr": "^1.34.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
